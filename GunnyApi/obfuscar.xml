<?xml version='1.0'?>
<Obfuscator>
  <Var name="InPath" value=".\bin\Release\net8.0" />
  <Var name="OutPath" value=".\bin\Release\net8.0\Obfuscated" />

  <!-- Các Option khác giữ nguyên như bạn đã chọn -->

  <!-- MODULE DLL -->
  <Module file="$(InPath)\GunnyApi.dll">
    <!-- Giữ các phương thức 'Invoke', 'InvokeAsync' của tất cả type trong module -->
    <SkipMethod type="*" name="Invoke"/>
    <SkipMethod type="*" name="InvokeAsync"/>
  </Module>
  <Module file="$(InPath)\CenterService.Client.dll">
    <SkipMethod type="*" name="Invoke"/>
    <SkipMethod type="*" name="InvokeAsync"/>
  </Module>
</Obfuscator>
